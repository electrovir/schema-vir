        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@web/dev-server-esbuild": "^2.0.0",
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-commands": "^1.0.1",
        "@web/test-runner-playwright": "^1.0.0",
        "@web/test-runner-visual-regression": "^1.0.1",
        "cspell": "^10.3.4",
        "dependency-cruiser": "^18.4.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^64.5.4",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.12.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.1",
        "eslint-plugin-unicorn": "^76.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "npm-check-updates": "^23.1.0",
